  m_text: "\uBB34\uC758\uC2DD\uC758 \uB05D\uC5D0\uC11C \uB098\uB97C \uCAD3\uB358
    \uB2E4\uC12F \uAD34\uBB3C\uC744 \uB9C8\uC8FC\uD588\uB2E4. \uADF8\uB4E4\uC740
    \uD0C0\uC778\uC774 \uC544\uB2CC,        \uB0B4 \uD2B8\uB77C\uC6B0\uB9C8\uAC00
    \uBE5A\uC5B4\uB0B8 \uB098\uC758 \uD30C\uD3B8\uB4E4\uC774\uC5C8\uB2E4.\n\uB098\uB294
    \uBE44\uBA85 \uC9C0\uB974\uB358 \uADF8 \uC870\uAC01\uB4E4\uC744 \uD558\uB098\uD558\uB098
    \uB098\uC758 \uC774\uB984\uC73C\uB85C \uC218\uC6A9\uD588\uB2E4.               
    \uBE44\uB85C\uC18C \uAE30\uAD34\uD55C \uD544\uAE30\uCCB4\uB4E4\uC774 \uBA48\uCD94\uACE0,
    \uC77C\uAE30\uC7A5\uC5D4 \uACE0\uC694\uAC00 \uCC3E\uC544\uC654\uB2E4.\n\uBC88\uC9C4
    \uC789\uD06C \uC790\uAD6D\uC744 \uB4A4\uB85C\uD55C \uCC44, \uC628\uC804\uD574\uC9C4
    \uB098\uC758 \uC190\uC73C\uB85C \uCC45\uC7A5\uC744 \uB36E\uB294\uB2E4.             
    \uC8FC\uC778\uC744 \uB418\uCC3E\uC740 \uBAB8 \uC704\uB85C, \uD604\uC2E4\uC758
    \uC120\uBA85\uD55C \uBE5B\uC774 \uC3DF\uC544\uC9C4\uB2E4. "
